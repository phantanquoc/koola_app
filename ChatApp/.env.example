# Copy this to .env and set DEV_HOST to your machine's LAN IPv4.
# Find IP on Windows:  ipconfig  (look for "IPv4 Address" of Wi-Fi / Ethernet)
# Find IP on macOS/Linux:  ifconfig | grep inet
# Device and dev machine must be on the same Wi-Fi.
DEV_HOST=192.168.1.100
DEV_PORT=3000

# Optional full-URL overrides — leave empty to derive from DEV_HOST/DEV_PORT
API_URL=
WS_URL=

# Production endpoints (used when __DEV__ is false)
PROD_API_URL=https://api.koola.chat/api
PROD_WS_URL=https://api.koola.chat
