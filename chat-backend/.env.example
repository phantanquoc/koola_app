# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/chatapp

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ─── TURN / Coturn ───────────────────────────────────────────────────────────
# COTURN_IP must be reachable by BOTH call peers:
#   - Dev (2 devices, same Wi-Fi): host LAN IP (e.g. 192.168.1.50)
#   - Prod: public IP / domain of the coturn host
#   - Do NOT use 10.0.2.2 (Android-emulator-only alias — breaks real-device calls)
#   - In infra-local, this same value drives coturn's --external-ip/--realm.
COTURN_IP=localhost
COTURN_PORT=3478
# Host the BACKEND uses to reach coturn for its /health TCP probe. This is an
# INTERNAL address and is never sent to clients — COTURN_IP stays the
# peer-facing value in the ICE server list. Same split as
# MINIO_ENDPOINT (internal) vs MINIO_PUBLIC_HOST (client-facing).
#   - infra-local: chat-coturn (the compose service name)
#   - coturn on the same host as the backend: localhost
#   - Leave empty/unset to fall back to COTURN_IP.
# Why it matters: with COTURN_IP=localhost the probe connects to the backend's
# own loopback and reports `coturn: up` even when coturn is down or pointed at
# a dead IP — a health check that lies.
COTURN_INTERNAL_HOST=
# REQUIRED. Long random string. Server refuses to start in non-test envs if empty.
# In infra-local, this value also drives coturn's --static-auth-secret, so the
# backend and coturn always share one secret (no manual conf sync needed).
TURN_STATIC_SECRET=
# Optional. Comma-separated public STUN fallback (used even when coturn is down).
# Defaults to Google STUN when unset; set to empty to disable the fallback.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ─── MinIO / S3 ──────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatapp
MINIO_USE_SSL=false

# ─── MinIO public endpoint (URLs sent to mobile clients) ─────────────────────
# Backend signs presigned PUT/GET URLs with this hostname. Must be reachable
# from the device that uploads/downloads media.
#
# Dev environments:
#   - Android emulator: MINIO_PUBLIC_HOST=10.0.2.2 (host loopback alias)
#   - iOS simulator:    MINIO_PUBLIC_HOST=localhost
#   - Physical device:  MINIO_PUBLIC_HOST=<host LAN IP> or use adb reverse 9000
# Production:
#   - Set to the public MinIO domain (e.g. media.example.com), MINIO_PUBLIC_USE_SSL=true
#
# If unset, falls back to MINIO_ENDPOINT/MINIO_PORT/MINIO_USE_SSL.
MINIO_PUBLIC_HOST=10.0.2.2
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
# Region is pinned to skip the lazy `GET /<bucket>?location` lookup, which the
# backend cannot perform against the device-facing public host. Default works
# for standard single-region MinIO; only change for a real multi-region S3.
MINIO_REGION=us-east-1

# ─── Firebase / FCM ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── OTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ─── Plivo (SMS OTP) ─────────────────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# ─── Translation providers (pluggable) ───────────────────────────────────────
# Selects the primary provider for POST /api/translate.
# Values: google (default) | mymemory | llm | auto
#  - google:   Google Cloud Translation v2 (requires GOOGLE_TRANSLATE_API_KEY)
#  - mymemory: MyMemory free tier (no key required; MYMEMORY_EMAIL lifts quota)
#  - llm:      Claude/GPT via TRANSLATION_LLM_ENABLED + ANTHROPIC_API_KEY
#  - auto:     try google, on retriable failure fallback once to mymemory
# Fallback: Google 429/5xx/3s timeout → one MyMemory attempt before 502.
# Cache (Redis 30-day TTL, provider-agnostic) is always checked first.
TRANSLATION_PROVIDER=google

# API key for the Google Cloud Translation v2 REST API, used by
# POST /api/translate when TRANSLATION_PROVIDER=google|auto|llm.
# The backend calls https://translation.googleapis.com/language/translate/v2
# over plain HTTPS with a 3 s timeout; results are cached in Redis for 30 days
# under translate:* keys.
GOOGLE_TRANSLATE_API_KEY=

# Optional email for MyMemory (api.mymemory.translated.net). Free tier works
# without it but with lower daily quota (~1000/day). Setting an email lifts
# quota toward 5000/day. Used as the `de` query param.
MYMEMORY_EMAIL=
# Set MYMEMORY_ENABLED=false to disable the MyMemory provider entirely and
# force the mock fallback `[lang] text` when Google is unconfigured or all
# providers fail. Useful for offline dev without network. In non-production
# (NODE_ENV !== 'production') the service also returns mock as an ultimate
# fallback after exhausting the provider chain, so dev never sees 502.
# MYMEMORY_ENABLED=true  (default — fallback is attempted)
# MYMEMORY_ENABLED=false (disable — mock path is taken)
# TRANSLATION_PROVIDER=google-strict also disables MyMemory fallback (Google-only).


# Optional LLM provider for premium translation (gated by TRANSLATION_LLM_ENABLED).
# When TRANSLATION_PROVIDER=llm and TRANSLATION_LLM_ENABLED=true, the backend
# calls the LLM API with prompt "Translate to {targetLang}, return JSON
# {translatedText, sourceLang}". Without the gate or key, llm reports
# isConfigured()=false and the service falls through to google→mymemory→mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRANSLATION_LLM_ENABLED=false
