coverage/

# React Native / Android build artifacts (explicit)
ChatApp/android/.gradle/
ChatApp/android/.kotlin/
ChatApp/android/app/build/
ChatApp/android/app/.cxx/
ChatApp/android/build/
ChatApp/android/local.properties

# iOS (nếu sau này dùng)
ChatApp/ios/build/
ChatApp/ios/Pods/
ChatApp/ios/DerivedData/

# React Native bundle output (tạo lại mỗi build release)
ChatApp/android/app/src/main/assets/index.android.bundle
ChatApp/android/app/src/main/res/drawable-*/
ChatApp/android/app/src/main/res/raw/

# Task / tmp runtime
.claude/tasks/

# Dev config — machine-specific LAN IP (generated by npm run dev:sync-host)
ChatApp/dev-config.json

# GitNexus binary cache + meta (regenerated by `npx gitnexus analyze`)
.gitnexus/lbug
.gitnexus/meta.json
.gitnexus/parse-cache/

# Local screenshots / dev artifacts
.screenshots/
screenshots/
koola_screen.png
ChatApp/koola_screen.png
ChatApp/ui.xml

# Built APKs + raw measurement output (APKs are ~138MB each; the CSVs worth
# keeping are copied into docs/perf-measurements/ instead).
build-artifacts/
# Archived perf APKs (local-only; see apk-archive/README.md).
apk-archive/*.apk
apk-archive/*.json

# Scratch dirs from audit tooling
.tmp_audit/
.fontaudit/

# Generated reports
docs/Bao_cao_tong_quat_APP_KOOLA.docx
docs/report-assets/

# Local-only MCP / accidental files
.mcp.json
/claude

.claude/settings.local.json
.codex/config.toml
opencode.json

# Session debug artifacts: screencaps / uiautomator dumps live at repo root only
