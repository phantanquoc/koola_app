        <mxCell id="a-title" value="APP_KOOLA — Flow Auth (OTP · Login · Refresh · Reset · Logout · Switch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="a1">
