        <!-- s6 -> s7 (FCM trigger) -->
        <mxCell id="e11" value="fire-and-forget" style="endArrow=block;html=1;strokeWidth=1.4;strokeColor=#F97316;endFill=1;dashed=1;dashPattern=6 4;fontSize=8;fontColor=#9A3412;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s7">
