        <mxCell id="a-lane4-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#FBCFE8;" vertex="1" parent="a1">
          <mxGeometry x="1060" y="62" width="340" height="1550" as="geometry"/>
        </mxCell>
        <mxCell id="a-lane4-h" value="Socket / FCM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DB2777;strokeColor=#BE185D;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1060" y="62" width="340" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-reg" value="1. DANG KY qua Email OTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="100" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-r1" value="RegisterScreen&#xa;POST /auth/register/init&#xa;{ email, password, displayName }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="128" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-r2" value="AuthService.registerInit&#xa;check trung email + hash OTP&#xa;hash password + rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="128" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-r3" value="Redis&#xa;reg:pending:&lt;email&gt; TTL 5p&#xa;otpHash + passwordHash&#xa;reg:rate / reg:attempts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#CA8A04;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="128" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a-r4" value="Nodemailer&#xa;gui OTP qua email&#xa;429 neu qua han muc" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="128" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-r5" value="OtpVerifyScreen&#xa;POST /auth/register/verify&#xa;{ email, otp } + countdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="200" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-r6" value="registerVerify&#xa;attempts &lt;= 5 ? so hash OTP&#xa;dung: tao User MongoDB&#xa;xoa 3 key Redis" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="430" y="194" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-r7" value="Mongo User&#xa;generateTokenPair()&#xa;RefreshToken (jti) + JWT AT&#xa;tra { AT, RT }" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="200" width="270" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="a-r8" value="verifyOtp() auto login&#xa;AT vao RAM + RT vao Async&#xa;GET /users/me + wireLocalFirst&#xa;socket connect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="200" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-login" value="2. DANG NHAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="280" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-l1" value="LoginScreen&#xa;POST /auth/login&#xa;{ email, password }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="308" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-l2" value="AuthService.login&#xa;findOne email, bcrypt.compare&#xa;check isBanned, generateTokenPair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="308" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-l3" value="Mongo&#xa;User + RefreshToken&#xa;(jti, revokedAt null)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="800" y="308" width="170" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-l4" value="login() AT RAM + RT Async&#xa;GET /users/me + /accounts/list&#xa;initDb + wireLocalFirst + seed&#xa;socket + webrtc + FCM register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="308" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-restore" value="3. KHOI PHUC PHIEN (AuthContext.restoreSession — moi lan mo app)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#FDE68A;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="390" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs1" value="App launch: read RT&#xa;tu AsyncStorage&#xa;khong co thi o man login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="418" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs2" value="POST /auth/refresh&#xa;verify JWT, check jti&#xa;reuse da revoke: revoke ALL" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.3;fontSize=8;align=center;" vertex="1" parent="a1">
          <mxGeometry x="420" y="410" width="220" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs3" value="Revoke RT cu + tao cap moi&#xa;AT moi + RT moi (rotation)&#xa;luu RT moi vao AsyncStorage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="418" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs4" value="GET /users/me (root)&#xa;+ GET /accounts/list&#xa;neu co activeAccountId (business)&#xa;POST /accounts/switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="490" width="310" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs5" value="mintAccessToken({ sub, act,&#xa;accountType: business })&#xa;KHONG xoay RT goc&#xa;tra biz AT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="490" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs6" value="initDb(activeId) + wireLocalFirst&#xa;seedConversations + socket/webrtc&#xa;connect(activeToken) + FCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="490" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-rs7" value="Fail: clearTokens + clearActiveId&#xa;ve man login (session chet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.3;fontSize=9;align=center;fontColor=#991B1B;" vertex="1" parent="a1">
          <mxGeometry x="750" y="490" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-refresh" value="4. REFRESH KHI AT HET HAN (interceptor 401)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#FBCFE8;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="580" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-rf1" value="API 401 (AT het han)&#xa;interceptor goi&#xa;refreshAccessTokenForSocket()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="608" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-rf2" value="POST /auth/refresh&#xa;200: luu RT moi + re-mint&#xa;biz token neu co activeAccountId&#xa;401/403 thi forceLogout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="608" width="320" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-rf3" value="network error&#xa;(khong co response)&#xa;{ reason: network } retry&#xa;khong logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="608" width="270" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-rf4" value="Socket: auth:refresh&#xa;hot swap JWT khi dang call&#xa;check same sub hoac same act&#xa;(cho phep switch business)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="608" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-reset" value="5. QUEN / DAT LAI MAT KHAU (2 buoc + resetTicket)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="700" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-fp1" value="POST /auth/forgot-password&#xa;{ email } luon 200 neutral&#xa;(khong lo email ton tai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="728" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-fp2" value="Gui OTP reset qua email&#xa;Redis: reset:pending + rate&#xa;giong flow register" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="728" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-fp3" value="POST /auth/reset-password/verify&#xa;{ email, otp } tra { resetToken }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="728" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-fp4" value="POST /auth/reset-password&#xa;{ resetToken, newPassword }&#xa;hash moi + revoke ALL RT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="728" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-sec-logout" value="6. DANG XUAT &amp; CHUYEN TAI KHOAN BUSINESS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#FECACA;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="a1">
          <mxGeometry x="10" y="810" width="1380" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="a-lo1" value="logout()&#xa;POST /auth/logout { refreshToken }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="838" width="310" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-lo2" value="AuthService.logout&#xa;verify JWT, revokedAt = now&#xa;clear FCM tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.3;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="838" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-lo3" value="Mobile teardown&#xa;unregister FCM + disconnect socket/webrtc&#xa;clearAll Async + MMKV + wipe SQLite&#xa;setUser(null) ve login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.4;fontSize=9;align=center;fontColor=#991B1B;" vertex="1" parent="a1">
          <mxGeometry x="750" y="838" width="270" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-sw1" value="switchAccount(targetId)&#xa;guard: callState !== idle thi block&#xa;POST /accounts/switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F97316;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="20" y="918" width="310" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a-sw2" value="mintAccessToken({ sub, act,&#xa;accountType: business })&#xa;KHONG xoay RT goc&#xa;tra biz AT moi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="370" y="918" width="320" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-sw3" value="GET /users/me (biz) =&gt; setUser(biz)&#xa;initDb(bizId) + reconnect&#xa;socket/webrtc bang biz AT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontSize=9;align=center;" vertex="1" parent="a1">
          <mxGeometry x="750" y="918" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-sw4" value="Force logout path&#xa;401 interceptor → forceLogoutHandler&#xa;wipe + disconnect + setUser(null)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.3;dashed=1;dashPattern=6 4;fontSize=9;align=center;fontColor=#991B1B;" vertex="1" parent="a1">
          <mxGeometry x="1080" y="918" width="300" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="a-note1" value="AT khong bao gio luu AsyncStorage — chi nam RAM. RT moi la durable credential. ThrottlerGuard tren moi route auth." style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontColor=#64748B;fontSize=8;fontStyle=2;" vertex="1" parent="a1">
          <mxGeometry x="10" y="1010" width="900" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-note2" value="Socket WsAuthGuard + event auth:refresh cho phep hot swap token giua cuoc goi. AppState foreground =&gt; reconnect socket." style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontColor=#64748B;fontSize=8;fontStyle=2;" vertex="1" parent="a1">
          <mxGeometry x="10" y="1026" width="900" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-leg-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="a1">
          <mxGeometry x="10" y="1050" width="1380" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a-leg-title" value="Chu giai" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontStyle=1;fontSize=10;fontColor=#0F172A;" vertex="1" parent="a1">
          <mxGeometry x="20" y="1056" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-leg-text" value="Hinh chu nhat = buoc xu ly  ·  Hinh thoi = re nhanh / kiem tra  ·  Cylinder = MongoDB / Redis  ·  Cloud = gui email / FCM  ·  Mui ten lien = happy path  ·  Net dut = fallback / teardown" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=9;fontColor=#334155;" vertex="1" parent="a1">
          <mxGeometry x="20" y="1074" width="1360" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-leg-text2" value="RefreshToken rotation: token cu bi revoked ngay khi tao cap moi. Reuse token da revoked =&gt; revoke TAT CA token cua user (chong replay attack)." style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=9;fontColor=#334155;" vertex="1" parent="a1">
          <mxGeometry x="20" y="1092" width="1360" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-leg-text3" value="Business switch: chi mint AT moi (sub + act), khong dong toi RT goc. act bi omit khi switch ve personal de token giong het token login ban dau." style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontSize=9;fontColor=#334155;" vertex="1" parent="a1">
          <mxGeometry x="20" y="1108" width="1360" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="a-footer" value="© APP_KOOLA  ·  File chung voi page Gui tin nhan text — mo cung file .drawio, chon tab Auth o duoi  ·  https://app.diagrams.net" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontColor=#94A3B8;fontSize=8;" vertex="1" parent="a1">
