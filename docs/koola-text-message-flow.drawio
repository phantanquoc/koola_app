        <mxCell id="leg-text3" value="Màu cam = FCM fallback (fire-and-forget cho offline users)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#334155;" vertex="1" parent="1">
