        <!-- Lane 2: Backend -->
        <mxCell id="lane2-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#BBF7D0;" vertex="1" parent="1">
          <mxGeometry x="300" y="66" width="300" height="1334" as="geometry"/>
