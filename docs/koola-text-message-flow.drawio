        <mxCell id="e9" value="fanout" style="endArrow=block;html=1;strokeWidth=1.4;strokeColor=#DB2777;endFill=1;fontSize=8;fontColor=#BE185D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="redis" target="s8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- s6 -> s9 ack path (sender reconcile) — curved back to Mobile lane -->
        <mxCell id="e10" value="message_ack / 201" style="endArrow=block;html=1;strokeWidth=1.4;strokeColor=#2563EB;endFill=1;dashed=0;fontSize=8;fontColor=#1E40AF;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s9">
