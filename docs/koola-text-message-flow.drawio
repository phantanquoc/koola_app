        <mxCell id="a-sub" value="AccessToken: JWT ngắn hạn, chỉ nằm RAM  ·  RefreshToken: xoay vòng, lưu MongoDB + AsyncStorage  ·  Guards: Passport JWT (REST) + WsAuthGuard (Socket)" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontColor=#64748B;fontSize=9;" vertex="1" parent="a1">
