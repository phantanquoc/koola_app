        <mxCell id="leg-shapes" value="⬭ Cylinder = MongoDB  &amp;nbsp;|&amp;nbsp;  ☁ Cloud = Redis / FCM  &amp;nbsp;|&amp;nbsp;  ◇ Diamond = rẽ nhánh (membership / dedup)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="625" y="992" width="545" height="18" as="geometry"/>
