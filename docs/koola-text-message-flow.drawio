        <mxCell id="leg-tip" value="Đọc ở 100% zoom — mỗi lane là 1 swimlane dọc. Mũi tên cắt ngang lane = gọi liên lane." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=8;fontColor=#94A3B8;fontStyle=2;" vertex="1" parent="1">
