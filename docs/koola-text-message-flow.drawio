        <mxCell id="lane2-header" value="⚙ Backend&#xa;(NestJS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="66" width="300" height="36" as="geometry"/>
        </mxCell>
        <!-- Lane 3: MongoDB + Redis -->
        <mxCell id="lane3-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#FDE68A;" vertex="1" parent="1">
          <mxGeometry x="600" y="66" width="300" height="1334" as="geometry"/>
        </mxCell>
        <mxCell id="lane3-header" value="🗄 MongoDB + Redis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CA8A04;strokeColor=#A16207;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="66" width="300" height="36" as="geometry"/>
        </mxCell>
        <!-- Lane 4: Clients khác -->
        <mxCell id="lane4-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#FBCFE8;" vertex="1" parent="1">
          <mxGeometry x="900" y="66" width="300" height="1334" as="geometry"/>
        </mxCell>
        <mxCell id="lane4-header" value="👥 Clients khác&#xa;(Socket)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DB2777;strokeColor=#BE185D;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="66" width="300" height="36" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 1 — User nhập ===== -->
        <mxCell id="s1" value="① User nhập text&#xa;ChatScreen → handleSend&#xa;→ useMessagesFromDb.sendMessage(text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="118" width="260" height="56" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 2 — Optimistic ===== -->
        <mxCell id="s2" value="② messageRepository&#xa;.insertOptimistic({ tempId,&#xa;status: pending })&#xa;→ bubble xám hiển thị ngay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="194" width="260" height="64" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 3 — Outbox enqueue ===== -->
        <mxCell id="s3" value="③ outboxRepository.enqueue&#xa;('send_message', { clientMessageId,&#xa;content, type })&#xa;dedup_key = clientMessageId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="278" width="260" height="64" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 4 — Outbox processor ===== -->
        <mxCell id="s4" value="④ outboxProcessor tick&#xa;→ messagesApi.send&#xa;POST /conversations/:id/messages&#xa;{ content, type, clientMessageId }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="362" width="260" height="64" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 5 — Backend intake ===== -->
        <mxCell id="s5" value="⑤ MessagesController&#xa;→ MessagesService.sendMessage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="362" width="260" height="44" as="geometry"/>
        </mxCell>

        <!-- Decision: membership -->
        <mxCell id="d1" value="Thành viên&#xa;của conv?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="385" y="426" width="130" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="d1-no" value="403 Forbidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.2;fontSize=9;align=center;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="530" y="438" width="60" height="34" as="geometry"/>
        </mxCell>

        <!-- Decision: dedup -->
        <mxCell id="d2" value="clientMessageId&#xa;đã tồn tại?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="385" y="504" width="130" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="d2-yes" value="Dedup → trả lại&#xa;message cũ (idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.2;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="510" width="60" height="46" as="geometry"/>
        </mxCell>

        <!-- DB cylinder — Message insert -->
        <mxCell id="db1" value="MongoDB&#xa;insert Message&#xa;+ update Conversation&#xa;.lastMessage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="645" y="504" width="210" height="70" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 6 — Broadcast ===== -->
        <mxCell id="s6" value="⑥ ChatGateway&#xa;.broadcastNewMessage()&#xa;io.to([ conversation:xxx,&#xa;user:memberId… ])&#xa;.emit('new_message')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="592" width="260" height="72" as="geometry"/>
        </mxCell>

        <!-- Redis cloud -->
        <mxCell id="redis" value="Redis Adapter&#xa;pub/sub fanout&#xa;multi-instance&#xa;dedup 1 copy / socket&#xa;except sender socket" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="645" y="592" width="210" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="redis-note" value="Đã có message_ack / REST 201&#10;nên sender bị except" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontColor=#854D0E;fontSize=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="645" y="666" width="210" height="22" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 7 — FCM ===== -->
        <mxCell id="s7" value="⑦ fire-and-forget&#xa;triggerPushNotifications()&#xa;→ FCM cho offline users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.5;fontSize=10;align=center;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="704" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="fcm" value="☁ FCM" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.5;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="685" y="710" width="120" height="44" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 8 — Clients online ===== -->
        <mxCell id="s8" value="⑧ socketService on 'new_message'&#xa;→ socketEventRouter&#xa;.wireSocketEvents&#xa;→ messageRepository&#xa;.applySocketEvent (idempotent&#xa;upsert SQLite) → re-render" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="920" y="592" width="260" height="92" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 9 — Sender reconcile ===== -->
        <mxCell id="s9" value="⑨ Sender nhận message_ack&#xa;(socket) hoặc REST 201&#xa;→ reconcile tempId → realId&#xa;status: sent ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="704" width="260" height="72" as="geometry"/>
        </mxCell>

        <!-- ===== STEP 10 — Recovery ===== -->
        <mxCell id="s10" value="⑩ Recovery / bù sync&#xa;GET /messages/sync?since=&amp;cursor&#xa;idempotent bằng clientMessageId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.5;fontSize=10;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s10b" value="Phục hồi khi fanout rớt&#xa;hoặc client offline →&#xa;sync bù khi reconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.2;fontSize=9;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="320" y="800" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s10c" value="MongoDB query&#xa;updatedAt &gt; cursor&#xa;(LOCAL_FIRST_SQLITE)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.2;fontSize=9;align=center;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="670" y="800" width="160" height="56" as="geometry"/>
        </mxCell>

        <!-- ===== FAILURE MODES NOTE BOX ===== -->
        <mxCell id="failbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="560" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="failtitle" value="⚠ Failure modes &amp; ghi chú" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=11;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="30" y="896" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="failtext" value="• DB write OK nhưng broadcast fail → /messages/sync bù lại (since cursor, idempotent).&#10;• Client offline tại lúc emit → FCM fallback + sync khi reconnect (NetInfo → outboxProcessor).&#10;• Duplicate clientMessageId → dedup trả lại message cũ, không insert mới.&#10;• Quên leave room (conv:xxx) → leak event, user nhận tin của conv cũ — phải leave on unmount.&#10;• Emit trước khi DB commit → race: instance khác chưa thấy message — luôn persist trước, emit sau.&#10;• Outbox dedup_key + SQLite upsert đảm bảo idempotent cả 2 đầu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="30" y="918" width="540" height="132" as="geometry"/>
        </mxCell>

        <!-- ===== SMALL NOTES ===== -->
        <mxCell id="note-opt" value="Optimistic UI: bubble xám ngay,&#10;không chờ REST" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontColor=#1E40AF;fontSize=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="285" y="210" width="110" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="note-dedup" value="Idempotent:&#10;clientMessageId" style="text;html=1;strokeColor=none;fillColor=none;align=center;whiteSpace=wrap;fontColor=#854D0E;fontSize=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="300" width="80" height="24" as="geometry"/>
