        <mxCell id="a-lane3-h" value="Redis + MongoDB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CA8A04;strokeColor=#A16207;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="a1">
