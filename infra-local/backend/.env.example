# Chat App — Backend Environment Variables
# Copy this to infra-local/backend/.env

# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── SMTP (Email OTP — registration + password reset) ─────
# Required for email OTP. Gmail: enable 2FA, then create an App Password at
# myaccount.google.com/apppasswords (NOT your normal password).
# Leave SMTP_USER/SMTP_PASS empty to disable email (register/init returns 503).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@koola.app

# ─── MongoDB ──────────────────────────────────────────────
# Local: mongodb://localhost:27017/chat
# Proxmox: mongodb://192.168.1.102:27017/chat
MONGODB_URI=mongodb://localhost:27017/chat

# ─── Redis ────────────────────────────────────────────────
# Local: redis://localhost:6379
# Proxmox: redis://192.168.1.104:6379
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# ─── MinIO ────────────────────────────────────────────────
# Local: http://localhost:9000
# Proxmox: http://192.168.1.103:9000
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=chatadmin
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET=chat-media

# ─── Coturn / TURN ───────────────────────────────────────
# Local: 127.0.0.1:3478
# Proxmox: <VM3-public-IP>:3478
COTURN_IP=127.0.0.1
COTURN_PORT=3478
TURN_STATIC_SECRET=your-turn-secret-here

# ─── Firebase (FCM) ──────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts
# Leave empty for local testing (notifications will be skipped)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Frontend URL (CORS) ─────────────────────────────────
# Local React Native dev: http://localhost:8081
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:8081
